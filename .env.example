# Copy this file to `.env` and fill in real values. `.env` is gitignored — never commit it.
# Keys that match a config section (e.g. Jwt__SigningKey -> Jwt:SigningKey) use .NET's
# double-underscore environment variable convention and are read directly by the API,
# whether it's run via `dotnet run` (loaded from this file by DotNetEnv) or via
# docker-compose (injected as real environment variables into the container).

# ── App ─────────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development
API_PORT=8080

# Staff (office) portal address, linked from staff emails — forced password resets and office transfers.
StaffPortal__Url=https://office.bckashcoop.com
# Password a bulk forced reset gives every staff member — exactly 8 characters. Leave empty to
# give each staff member their own random one. Either way they must change it on next sign-in.
StaffPortal__DefaultResetPassword=

# Optional fixed login / password-reset OTP, accepted alongside the generated code that's
# emailed and SMS'd (for testing when delivery isn't available). Leave empty in production.
MASTER_OTP=

# ── Database ────────────────────────────────────────────────────────────
# Used both to configure the `db` container (docker-compose.yml) and to build the API's
# connection string below. Keep DB_NAME/DB_USER/DB_PASSWORD in sync with the string.
DB_NAME=bckashTestDB
DB_USER=bckashAdmin
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme
DB_EXTERNAL_PORT=3307
# InnoDB buffer pool (MariaDB memory cache). 1G fits a 4GB server; raise it on bigger hosts.
DB_BUFFER_POOL_SIZE=1G

# Connection string the API uses when run OUTSIDE docker (dotnet run), pointing at the
# docker-composed MariaDB via its host-mapped port above. Inside docker-compose, the `api`
# service overrides this to use the `db` service hostname instead — see docker-compose.yml.
ConnectionStrings__BCKashDb=Server=localhost;Port=3307;Database=bckashTestDB;User=bckashAdmin;Password=changeme;

# Legacy phpMyAdmin dump loaded by scripts/seed-legacy-dump.sh, relative to the repo root.
# Lives in the gitignored `dbdump/` folder at the repo root, locally and on the server.
LEGACY_DUMP_PATH=./dbdump/bckbbjxq_real.sql

# ── Redis (backs the EF Core second-level cache — every DB read/write routes through it) ──
REDIS_PASSWORD=changeme
REDIS_EXTERNAL_PORT=6380
ConnectionStrings__Redis=localhost:6380,password=changeme

# ── JWT ─────────────────────────────────────────────────────────────────
Jwt__SigningKey=changeme-32-plus-random-bytes
Jwt__Issuer=BCKash.Api
Jwt__Audience=BCKash.Portal

# ── SMS (Termii) ────────────────────────────────────────────────────────
Sms__Provider=https://v4.api.termii.com/api/sms/send
Sms__ApiKey=changeme
Sms__SenderId=BCKash

# ── Email (SMTP) ────────────────────────────────────────────────────────
Email__SmtpHost=smtp-relay.brevo.com
Email__SmtpPort=465
Email__SmtpUsername=changeme
Email__SmtpPassword=changeme
Email__FromAddress=hello@example.com
Email__FromName=BCKash MFB

# ── BVN verification (BC Kash MFB core gateway) ─────────────────────────
# Login used to verify clients' BVNs during onboarding (POST /initialisation/init, then
# POST /identity/get_bvn). Wrap the password in single quotes if it contains special characters.
BvnGateway__BaseUrl=https://core.bckashmfb.com/v1
BvnGateway__Email=
BvnGateway__Password=
# Testing only — skip the gateway and answer every BVN lookup with mock details:
#   isAMatch      → the BVN record matches exactly what was submitted
#   isConflicting → random details that differ from what was submitted (tests the mismatch path)
# Leave unset (or empty) to verify every BVN with the gateway. Never set this in production.
UseMockBvn=

# ── AWS (S3 file storage + Rekognition face biometrics) ─────────────────
# With credentials and a bucket, every upload goes to S3 (images under img/, everything else under
# documents/, named after the client). Without them files stay on local disk and face capture is off.
# Face Liveness isn't offered in London (eu-west-2), so liveness sessions use Ireland (eu-west-1).
# The IAM user needs: s3:PutObject/GetObject/DeleteObject on the bucket, rekognition:CreateFaceLivenessSession,
# rekognition:GetFaceLivenessSessionResults, rekognition:StartFaceLivenessSession, rekognition:CompareFaces,
# and sts:GetFederationToken (for the browser's short-lived liveness credentials).
Aws__Region=eu-west-2
Aws__LivenessRegion=eu-west-1
Aws__AccessKeyId=
Aws__SecretAccessKey=
Aws__S3Bucket=
# Pass marks (0–100): how alike a loan face capture must be to the enrolled face, and how sure the
# liveness check must be that a live person was in front of the camera.
Biometrics__FaceMatchThreshold=90
Biometrics__LivenessThreshold=80

# ── Bootstrap super admin (seeded once, only if no super_admin exists yet) ─
Bootstrap__SuperAdminEmail=
Bootstrap__SuperAdminFirstName=System
Bootstrap__SuperAdminLastName=Administrator
Bootstrap__SuperAdminPhone=
